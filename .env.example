# Used by `docker compose` (read from a `.env` next to docker-compose.yml).
# Copy to `.env` — the defaults below work as-is for a local test.
# CHANGE BOTH VALUES for anything beyond testing (they are public in git).
# Not read by `npm run dev` — that uses apps/server/.env.

# Required. PostgreSQL password; letters and digits only (it goes into a URL).
NEBULADB_POSTGRES_PASSWORD=nebuladbtest123

# Encrypts stored DB credentials, 2FA and webhook secrets: `openssl rand -hex 32`.
NEBULADB_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: physical volume names, to reuse existing volumes when upgrading.
# NEBULADB_POSTGRES_VOLUME=nebuladb-postgres
# NEBULADB_DATA_VOLUME=nebuladb-data
