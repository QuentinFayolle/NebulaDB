# Local dev environment — loaded automatically via `process.loadEnvFile()`
# (see src/loadEnv.ts, imported first in src/index.ts). Gitignored: never
# commit real secrets here. Full reference: apps/server/src/config.ts.

# Required — encryption key for stored DB connection credentials and 2FA
# secrets. Test value below; generate your own (`openssl rand -hex 32`) for real use. Changing it later makes
# stored credentials undecryptable.
NEBULADB_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Everything below is optional — defaults shown are what config.ts already
# falls back to, spelled out here so they're easy to find and tweak.

PORT=3001
NODE_ENV=development

# PostgreSQL holding app metadata (users, projects, connections, audit...). Local container: docker start nebuladb-postgres
NEBULADB_DATABASE_URL=postgres://nebuladb:nebuladbtest123@localhost:5432/nebuladb

# Session cookies aren't marked Secure on plain local HTTP; flip to true
# once this is served over TLS.
NEBULADB_COOKIE_SECURE=false

NEBULADB_LOG_LEVEL=info

# Extra CORS origins beyond the app's own host, comma-separated. Not needed
# for the default localhost:5173 (web) -> localhost:3001 (server) setup.
# NEBULADB_ALLOWED_ORIGINS=

NEBULADB_MAX_BODY_MB=4
NEBULADB_MAX_WS_FRAME_MB=8

# 0 = scheduled backups off (this session's own DB dir already gets an
# implicit one on shutdown/restore paths — see infrastructure/backup.ts).
NEBULADB_BACKUP_INTERVAL_HOURS=0
NEBULADB_BACKUP_DIR=./backups
NEBULADB_BACKUP_KEEP=7

# 365 days; 0 keeps every audit entry forever.
NEBULADB_AUDIT_RETENTION_DAYS=365

# Set to 1 to log server-side calls slower than 20ms (perf diagnostics only).
# NEBULADB_PERF_LOG=1

# Folder administrators may import seed CSV files from by path (Données initiales > Importer depuis le serveur).
NEBULADB_SEED_IMPORT_DIR=

# ---------------------------------------------------------------------------
# Added since: everything below is optional and commented out at its default.
# ---------------------------------------------------------------------------

# Max connections the server keeps open to its own PostgreSQL (1-200).
# NEBULADB_DATABASE_POOL_SIZE=10

# Previous NEBULADB_SECRET, only while rotating the key (old data stays readable).
# NEBULADB_SECRET_PREVIOUS=

# Reverse proxy trust: false | true | hop count (1 = single nginx) | IP/CIDR list.
# NEBULADB_TRUST_PROXY=false

# Public URL users reach the app at; required when SMTP is configured.
# NEBULADB_PUBLIC_URL=https://nebuladb.example.com

# Outgoing email (invitations, password reset). Unset host = email off.
# NEBULADB_SMTP_HOST=
# NEBULADB_SMTP_PORT=587
# NEBULADB_SMTP_SECURE=false
# NEBULADB_SMTP_USER=
# NEBULADB_SMTP_PASSWORD=
# NEBULADB_SMTP_FROM="NebulaDB <noreply@example.com>"

# Retention (days, 0 = forever) for the SQL console figures and DB session figures.
# NEBULADB_QUERY_STATS_RETENTION_DAYS=
# NEBULADB_DB_ACTIVITY_RETENTION_DAYS=

# Minutes between connectivity checks of saved connections (0 = off).
# NEBULADB_CONNECTION_HEALTH_INTERVAL_MINUTES=15

# Backups of connected databases (the "Sauvegardes" tab).
# NEBULADB_DATABASE_BACKUP_DIR=./data/database-backups
# NEBULADB_DATABASE_BACKUP_MAX_MB=512
# NEBULADB_DATABASE_BACKUP_RETENTION_DAYS=30

# Seed CSV storage and limits.
# NEBULADB_SEED_DIR=./data/seeds
# NEBULADB_SEED_FILE_MAX_GB=20
# NEBULADB_SEED_MAX_KEYS=5000000

# Restrict SQLite connections to files inside this directory (unset = any path).
# NEBULADB_SQLITE_DIR=

# Webhooks: private/loopback targets are refused unless allowed here or BLOCK_PRIVATE=0.
# NEBULADB_WEBHOOK_BLOCK_PRIVATE=1
# NEBULADB_WEBHOOK_ALLOWED_HOSTS=
