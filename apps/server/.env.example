# Copy to apps/server/.env (loaded automatically, gitignored). All optional unless noted.

PORT=3001
# Required: the PostgreSQL database NebulaDB keeps its own data in (its tables are created at boot).
NEBULADB_DATABASE_URL=postgres://nebuladb:password@localhost:5432/nebuladb
# NEBULADB_DATABASE_POOL_SIZE=10

# Required before connecting a database or enabling 2FA: openssl rand -hex 32
NEBULADB_SECRET=

# true when served over TLS
NEBULADB_COOKIE_SECURE=false
# NEBULADB_ALLOWED_ORIGINS=https://other-origin.example.com
NEBULADB_LOG_LEVEL=info

# Email (invitations, password reset). Off without a host.
# NEBULADB_PUBLIC_URL=https://schemas.example.com
# NEBULADB_SMTP_HOST=smtp.example.com
# NEBULADB_SMTP_PORT=587
# NEBULADB_SMTP_USER=
# NEBULADB_SMTP_PASSWORD=
# NEBULADB_SMTP_FROM=NebulaDB <noreply@example.com>

# Automatic backups of every project (0 = off)
NEBULADB_BACKUP_INTERVAL_HOURS=0
NEBULADB_BACKUP_DIR=./backups
NEBULADB_BACKUP_KEEP=7

# Retention in days (0 = forever)
NEBULADB_AUDIT_RETENTION_DAYS=365

# Initial data too big for the database is kept as one CSV file per table in this folder.
# NEBULADB_SEED_DIR=./data/seeds
# Largest seed file, in GB, and how many key values its checks may keep in memory.
# NEBULADB_SEED_FILE_MAX_GB=20
# NEBULADB_SEED_MAX_KEYS=5000000
# Folder administrators may import seed files from by path (unset: off).
# NEBULADB_SEED_IMPORT_DIR=C:/data/seed-import
NEBULADB_QUERY_STATS_RETENTION_DAYS=30
NEBULADB_DB_ACTIVITY_RETENTION_DAYS=14
NEBULADB_DATABASE_BACKUP_RETENTION_DAYS=30
