# Local dev environment — loaded automatically via `process.loadEnvFile()`
# (see src/loadEnv.ts, imported first in src/index.ts). Gitignored: never
# commit real secrets here. Full reference: apps/server/src/config.ts.

# Required — encryption key for stored DB connection credentials and 2FA
# secrets. Reused from this session's earlier ad-hoc value (every connection
# currently stored in the DeepDetect project's dev DB was encrypted with this
# key) rather than a freshly generated one — changing it makes every stored
# connection's credentials undecryptable. Regenerate your own
# (`openssl rand -hex 32`) for anything beyond continuing this local dev DB.
NEBULADB_SECRET=a3a8d19493f7b50b12f1dd3dd358c0c874ba57f57e3ff0bbe79113db8454c0af

# Everything below is optional — defaults shown are what config.ts already
# falls back to, spelled out here so they're easy to find and tweak.

PORT=3001
NODE_ENV=development

# PostgreSQL holding app metadata (users, projects, connections, audit...). Local container: docker start nebuladb-postgres
NEBULADB_DATABASE_URL=postgres://nebuladb:a467cfff5e65e92e6678b623a279c66b@localhost:5432/nebuladb

# Session cookies aren't marked Secure on plain local HTTP; flip to true
# once this is served over TLS.
NEBULADB_COOKIE_SECURE=false

NEBULADB_LOG_LEVEL=info

# Extra CORS origins beyond the app's own host, comma-separated. Not needed
# for the default localhost:5173 (web) -> localhost:3001 (server) setup.
# NEBULADB_ALLOWED_ORIGINS=

NEBULADB_MAX_BODY_MB=4
NEBULADB_MAX_WS_FRAME_MB=8

# 0 = scheduled backups off (this session's own DB dir already gets an
# implicit one on shutdown/restore paths — see infrastructure/backup.ts).
NEBULADB_BACKUP_INTERVAL_HOURS=0
NEBULADB_BACKUP_DIR=./backups
NEBULADB_BACKUP_KEEP=7

# 365 days; 0 keeps every audit entry forever.
NEBULADB_AUDIT_RETENTION_DAYS=365

# Set to 1 to log server-side calls slower than 20ms (perf diagnostics only).
# NEBULADB_PERF_LOG=1

# Folder administrators may import seed CSV files from by path (Données initiales > Importer depuis le serveur).
NEBULADB_SEED_IMPORT_DIR=
